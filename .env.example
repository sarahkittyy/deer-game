# deer-server configuration. Copy to .env; the server reads it from the working directory.
# Production keeps its own copy at /srv/deer/.env (DEER_HOST=127.0.0.1 behind nginx).

# Address the server binds. Behind nginx keep it on loopback.
DEER_HOST=0.0.0.0
DEER_PORT=3560
# Local development only: also serve the web build from this directory (production uses nginx).
# DEER_STATIC=dist
RUST_LOG=info
